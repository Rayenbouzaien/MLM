# Copy this to .env (same folder as docker-compose.yml) and adjust as needed.
# docker compose reads .env automatically for variable substitution.

POSTGRES_PASSWORD=devpassword
ALLOWED_ORIGINS=http://localhost:8443
PGPOOL_MAX=15

# Session signing secret, 16+ chars. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=6a95da1f89fda4ecf144c58104109efec475aedad1ac80aab7fdd93d953aca70

# Password for the /admin dashboard login. Change this.
ADMIN_PASSWORD=dev-admin-pass
