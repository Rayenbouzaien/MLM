# Copy to .env next to docker-compose.yml:  cp .env.example .env
# docker compose reads it automatically.

# Postgres superuser password (also used to build DATABASE_URL for the api).
# Keep it URL-safe (letters/digits/-_) because it is embedded in a URL.
POSTGRES_PASSWORD=devpassword

# Session signing secret, 16+ chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-32chars

# Password of the /admin dashboard (8+ chars).
ADMIN_PASSWORD=dev-admin-pass

# Port published on the host for the web UI.
WEB_PORT=8080

# Max Postgres connections per API replica (replicas x this < 100).
PGPOOL_MAX=10
