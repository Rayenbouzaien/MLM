{
  "name": "gridlock-hackathon-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "migrate": "node src/migrate.js",
    "test": "cross-env DOTENV_CONFIG_PATH=.env.test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:load": "cross-env DOTENV_CONFIG_PATH=.env.test NODE_OPTIONS=--experimental-vm-modules node tests/load/burst-submit.js",
    "test:smoke": "node tests/smoke/deployed-regression.js",
    "test:cold-start": "node tests/load/cold-start.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "redis": "^6.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "cross-env": "^7.0.3",
    "cross-fetch": "^4.1.0",
    "jest": "^30.5.0",
    "supertest": "^7.2.2"
  }
}
