# Use Neon's POOLED connection string (hostname contains "-pooler").
# Neon dashboard -> your project -> Connection Details -> "Pooled connection".
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Comma-separated list of frontend origins allowed to call this API.
# Example: https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=

# Max app-level Postgres connections this process will hold open.
# 10-15 is plenty since Neon's pooler multiplexes these further.
PGPOOL_MAX=15

# Session signing secret — required, 16+ chars. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Single shared admin password (used to log into the admin dashboard).
# Required, 8+ chars.
ADMIN_PASSWORD=

PORT=4000
