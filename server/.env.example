# Used only when running the API outside Docker (npm start).
# In Docker Compose / Kubernetes these values are injected by the platform.

DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/gridlock
PGSSL=false
PGPOOL_MAX=10

# Optional. Unset = in-memory live feed (single process).
# Set it to share the live feed between several API replicas.
REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed browser origins. Empty = allow all
# (fine when nginx proxies /api so everything is same-origin).
ALLOWED_ORIGINS=

# Session signing secret (16+ chars) and admin dashboard password (8+ chars).
JWT_SECRET=
ADMIN_PASSWORD=

# Cookie policy (see src/auth.js). Defaults suit plain-HTTP same-origin use.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Number of reverse-proxy hops to trust for X-Forwarded-For.
TRUST_PROXY=1

PORT=4000
